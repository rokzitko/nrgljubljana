#!/bin/bash
# Regenerate the prepared 'data' files of the convention tests with nrginit (requires Mathematica).
#
# Usage: generate [CASE...]        (default: all cases listed in simple_tests)
#        NRGINIT=/path/to/nrginit generate ...
#
# Each case is initialized in a temporary directory from its 'param' (and 'customoperators.m', if present). For cases
# with a 'coefficients' file, the Wilson-chain blocks of the generated data (from the line 'z' to the end of the file)
# are replaced by the contents of that file. The references in */ref are not touched: they are shared between the
# symmetry types of one physical problem and define the conventions (see README.md).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
nrginit="${NRGINIT:-$here/../../nrginit/nrginit}"

if [ $# -gt 0 ]; then
  cases=("$@")
else
  cases=()
  while IFS= read -r line; do [ -n "$line" ] && cases+=("$line"); done < "$here/simple_tests"
fi

for c in "${cases[@]}"; do
  src="$here/$c"
  [ -f "$src/param" ] || { echo "$c: no param file" >&2; exit 1; }
  tmp="$(mktemp -d)"
  cp "$src/param" "$tmp/"
  [ -f "$src/customoperators.m" ] && cp "$src/customoperators.m" "$tmp/"
  if ! (cd "$tmp" && "$nrginit" > log 2>&1) || [ ! -s "$tmp/data" ]; then
    echo "$c: nrginit failed, see $tmp/log" >&2
    exit 1
  fi
  if [ -f "$src/coefficients" ]; then
    grep -q '^z$' "$tmp/data" || { echo "$c: no 'z' block in generated data" >&2; exit 1; }
    sed '/^z$/,$d' "$tmp/data" > "$src/data"
    cat "$src/coefficients" >> "$src/data"
  else
    cp "$tmp/data" "$src/data"
  fi
  rm -rf "$tmp"
  echo "$c: data generated"
done
