#!/bin/bash
set -euo pipefail

source_dir=$1
build_dir=$2
kernel=$3
export LD_LIBRARY_PATH="$build_dir/c++${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
work=$(mktemp -d "$build_dir/test/nrginit/rkpw-pipeline.XXXXXX")

for mode in rkpw cpp; do
  mkdir "$work/$mode"
  (
    cd "$work/$mode"
    if [ "$mode" = rkpw ]; then
      # This golden fixture uses tri=cpp; full reconstruction needs an old
      # baseline before the shared selector replaces it with tri=rkpw.
      perl -pe 's/^tri=cpp$/tri=old/' "$source_dir/test/c++/test40_tri/param" > param.input
    else
      cp "$source_dir/test/c++/test40_tri/param" param.input
    fi
    perl "$source_dir/test/chain-backend.pl" --backend rkpw --mode initializer --input param.input --output param
    if ! "$source_dir/nrginit/nrginit" "$kernel" > initializer.log 2>&1; then
      cat initializer.log
      exit 1
    fi
    test -s data
    bash "$source_dir/test/c++/runtest" "$source_dir" "$build_dir" "$source_dir/test/c++/test40_tri"
    if [ "$mode" = cpp ]; then
      perl -0777 -ne 'die "Runtime did not select RKPW\n" unless /Using scalar RKPW/' log
    fi
  )
done

# A nontrivial seed must also be constructed correctly from machine coefficients.
mkdir "$work/seed"
(
  cd "$work/seed"
  perl "$source_dir/test/chain-backend.pl" --backend rkpw --mode initializer \
    --input "$source_dir/test/nrginit/nrginit45_Ninit=1/param" --output param
  if ! "$source_dir/nrginit/nrginit" "$kernel" > initializer.log 2>&1; then
    cat initializer.log
    exit 1
  fi
  "$source_dir/test/compare-ignoresigns.pl" "$source_dir/test/nrginit/nrginit45_Ninit=1/ref"
)
printf 'RKPW initializer/solver pipeline passed (artifacts in %s).\n' "$work"
