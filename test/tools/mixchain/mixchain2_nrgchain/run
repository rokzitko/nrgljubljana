#!/bin/sh
# mixchain against adapt --integral + nrgchain on the tabulated density of nrgchain1. See param for why the tolerance
# is that of the FSOL tabulation rather than rounding.
set -eu
export PATH="$1:$PATH"
case "$CHAIN_TEST_BACKEND" in legacy) method=lanczos ;; rkpw) method=rkpw ;; *) exit 1 ;; esac
rm -f FSOL.dat FSOLNEG.dat theta.dat xi.dat zeta.dat V11.dat T11.dat E11.dat

cp "$3/../../nrgchain/nrgchain1/Delta.dat" Delta.dat
cp Delta.dat Gamma_11-re.dat

adapt --integral P param-nrgchain
adapt --integral N param-nrgchain
nrgchain -v param-nrgchain 2>nrgchain.err
grep -q "^  tridiag_method=$method$" nrgchain.err

for file in theta.dat xi.dat zeta.dat; do test -s "$file"; done

# Both methods of mixchain, each against the same nrgchain result.
for mixchain_method in lanczos rkpw; do
  rm -f V11.dat T11.dat E11.dat
  { cat param; printf '\ndiscretization_files=true\ntridiag_method=%s\n' "$mixchain_method"; } >param-mixchain
  mixchain -v param-mixchain >"mixchain-$mixchain_method.log" 2>&1
  grep -q "^  tridiag_method=$mixchain_method$" "mixchain-$mixchain_method.log"
  for file in V11.dat T11.dat E11.dat; do test -s "$file"; done
  echo "mixchain tridiag_method=$mixchain_method"
  sh "$3/../compare_nrgchain.sh" 1e-6
done
