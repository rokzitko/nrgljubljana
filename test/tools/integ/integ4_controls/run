#!/bin/sh
set -eu

integ="$1/integ"

"$integ" imaw.dat >default.dat
"$integ" --interpolation akima imaw.dat >akima.dat
"$integ" -i linear imaw.dat >linear.dat
"$integ" --interpolation=cspline imaw.dat >cspline.dat
"$integ" --interpolation steffen imaw.dat >steffen.dat

cmp default.dat akima.dat
expect_different() {
  if cmp "$1" "$2" >/dev/null 2>&1; then
    echo "integ interpolation outputs unexpectedly match: $1 and $2" >&2
    exit 1
  fi
}
expect_different linear.dat cspline.dat
expect_different linear.dat akima.dat
expect_different cspline.dat akima.dat
expect_different linear.dat steffen.dat
expect_different cspline.dat steffen.dat

# The linear fixture has an exact piecewise-linear absolute integral of 4523/660.
printf '%s\n' 6.8530303030303035 >expected-absolute.dat
"$integ" -i linear -a imaw.dat >absolute.dat
"$integ" -i linear -a -w imaw.dat >absolute-short-policy.dat
"$integ" -i linear -a --gsl-error-policy ignore imaw.dat >absolute-long-policy.dat
cmp expected-absolute.dat absolute.dat
cmp absolute.dat absolute-short-policy.dat
cmp absolute.dat absolute-long-policy.dat

# QAG controls are accepted but do not change an analytic quantity.
analytic_options="--epsabs 1e-300 --epsrel 0 --workspace-limit 1 --quadrature-rule 61"
for policy in ignore warn fail; do
  # shellcheck disable=SC2086
  "$integ" $analytic_options --gsl-error-policy "$policy" imaw.dat >"analytic-$policy.dat" 2>"analytic-$policy.stderr"
  cmp default.dat "analytic-$policy.dat"
  test ! -s "analytic-$policy.stderr"
done

# Exercise valid QAG controls only in positive-temperature Fermi mode.
"$integ" -f -T 0.5 --epsabs 0 --epsrel 1e-6 --workspace-limit 2048 imaw.dat >relative-tolerance.dat
"$integ" -f -T 0.5 --epsabs=1e-8 --epsrel=0 --workspace-limit=2048 imaw.dat >absolute-tolerance.dat

for rule in 15 21 31 41 51 61; do
  "$integ" -f -T 0.5 --epsabs 0 --epsrel 1e-6 --workspace-limit 2048 \
    --quadrature-rule "$rule" imaw.dat >"rule-$rule.dat"
done

for policy in ignore warn fail; do
  "$integ" -f -T 0.5 --epsabs 0 --epsrel 1e-6 --workspace-limit 2048 \
    --gsl-error-policy "$policy" imaw.dat >"policy-$policy.dat"
done

expect_failure() {
  name=$1
  message=$2
  shift 2
  if "$integ" "$@" imaw.dat >"$name.stdout" 2>"$name.stderr"; then
    echo "integ unexpectedly accepted invalid $name" >&2
    exit 1
  fi
  test ! -s "$name.stdout"
  grep -q '^integ: error:' "$name.stderr"
  grep -Fq "$message" "$name.stderr"
}

expect_failure interpolation "Interpolation method must be one of" --interpolation=nearest
expect_failure epsabs "Absolute integration tolerance must be a finite representable number" --epsabs=nan
expect_failure epsrel "Relative integration tolerance must be finite and nonnegative" --epsrel=-1
expect_failure tolerances "Relative integration tolerance is too small" --epsabs=0 --epsrel=0
expect_failure workspace "Workspace limit must be a positive integer" --workspace-limit=0
expect_failure rule "Quadrature rule must be one of" --quadrature-rule=17
expect_failure policy "GSL error policy must be one of" --gsl-error-policy=abort

printf '%s\n' '0 0' '1 1' >steffen-too-small.dat
if "$integ" -i steffen steffen-too-small.dat >steffen-too-small.stdout 2>steffen-too-small.stderr; then
  echo "integ unexpectedly accepted too few points for Steffen interpolation" >&2
  exit 1
fi
test ! -s steffen-too-small.stdout
grep -q '^integ: error:' steffen-too-small.stderr
grep -Fq "steffen interpolation requires at least 3 points." steffen-too-small.stderr

difficult_options="--epsabs 1e-300 --epsrel 0 --workspace-limit 1 --quadrature-rule 61"
# shellcheck disable=SC2086
"$integ" -f -T 0.5 $difficult_options --gsl-error-policy ignore imaw.dat >ignore-result.dat 2>ignore.stderr
test ! -s ignore.stderr

# shellcheck disable=SC2086
"$integ" -f -T 0.5 $difficult_options --gsl-error-policy warn imaw.dat >warn-result.dat 2>warn.stderr
grep -q '^integ: warning: qag error' warn.stderr

# The default policy warns and continues.
# shellcheck disable=SC2086
"$integ" -f -T 0.5 $difficult_options imaw.dat >default-policy-result.dat 2>default-policy.stderr
grep -q '^integ: warning: qag error' default-policy.stderr
cmp warn-result.dat default-policy-result.dat

# shellcheck disable=SC2086
expect_failure convergence "qag error" -f -T 0.5 $difficult_options --gsl-error-policy fail
