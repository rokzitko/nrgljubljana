#!/bin/bash
set -euo pipefail
# $1 = $PROJECT_SOURCE_DIR
# $2 = $PROJECT_BINARY_DIR
# $3 = $CMAKE_CURRENT_SOURCE_DIR/${test}

"$2/tools/adapt" P
"$2/tools/adapt" N

"$2/tools/instantiate"

"$1/test/clean-physical-output.pl"
if ! "$2/c++/nrg" 2>&1 | tee log; then
  echo "Abnormal termination. Skipping comparisons."
  exit 1
fi
if [ ! -f "DONE" ]; then
  echo "File DONE not found. Skipping comparisons."
  exit 1
fi

# The initializer basis has a gauge-dependent sign; physical results do not.
"$1/test/mycomp-ignoresigns.pl" "$3/ref/data" data
"$1/test/compare.pl" --strict --exclude data "$3/ref"
