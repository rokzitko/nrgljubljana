# The SIAM in a field along z, with a spin-dependent hybridisation, through the SIAM/U1 template with pol2x2=true.
#
# Gamma = diag(1/2, 1/4) is diagonal in spin space, so it splits into two blocks and the mixing coefficient sets
# xi3, xi4 vanish. What the case covers is the block splitting and the spin bookkeeping: swapping the up and down
# sets would change SZd and n_d_u/n_d_d, which the field makes visible. The mixing sets are covered by
# mixchain_u1_rotated.

[extra]
U1=0.1
eps1=-0.05
Bz1=0.02
Bx1=0

[param]
symtype=U1
pol2x2=true
Lambda=2.0
z=1.0
Nmax=20

keep=1000
keepenergy=8
T=1e-4
ops=n_d n_d^2 n_d_u n_d_d SZd SXd hop0
data_has_rescaled_energies=false
