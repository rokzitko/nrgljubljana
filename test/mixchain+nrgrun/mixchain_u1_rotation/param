# The SIAM in a tilted field through the SIAM/U1 template. run.sh substitutes the field components, which differ
# between the two routes: the diagonal one has the field along z, the rotated one the same field turned by phi.

[extra]
U1=0.1
eps1=-0.05
Bz1=__BZ__
Bx1=__BX__

[param]
symtype=U1
pol2x2=true
Lambda=2.0
z=1.0
Nmax=20

keep=1000
keepenergy=8
T=1e-4
ops=n_d n_d^2 n_d_u n_d_d SZd SXd hop0
data_has_rescaled_energies=false
