#!/usr/bin/env perl
# This tools analyzes a tabular representation of a function and refines the mesh (grid) over
# which it is defined. It does so by quantifying the accuracy of the linear extrapolation from
# two preceeding data points to the current data point. For large interpolation error, one
# additional point is added to the mesh (midway between the previous and the current point). 
# This is potentially useful in DMFT calculations for situation with sharp spectral features.
# Rok Zitko, 2025-2026

use strict;
use warnings;

use FindBin qw($Bin);
use lib $Bin;
use POSIX qw(isfinite);
use TableIO qw(parse_number read_records);

my $smalleps = 1e-38; # Anything smaller than this counts as zero frequency

my $debug = 1;
my $verbose = 1;
my $reject_zero = 1;

@ARGV >= 2 && @ARGV <= 4
    or die "Syntax: optimize_mesh <filename> <delta> [dxmin] [miny]\n";

my ($filename, $delta_text, $dxmin_text, $miny_text) = @ARGV;
$dxmin_text = 1e-12 unless defined($dxmin_text);
$miny_text = 1e-4 unless defined($miny_text);

my $delta = parse_number($delta_text, 'optimize_mesh: delta');
my $dxmin = parse_number($dxmin_text, 'optimize_mesh: dxmin');
my $miny = parse_number($miny_text, 'optimize_mesh: miny');
for my $control ([delta => $delta, $delta_text], [dxmin => $dxmin, $dxmin_text],
                 [miny => $miny, $miny_text]) {
    $control->[1] >= 0 or die
        "optimize_mesh: $control->[0] must be nonnegative, got '$control->[2]'\n";
}

my $records = read_records($filename, columns => 2);

my $maxrel = 0; # maximum relative error encountered in the file 
my $nradd = 0; # number of mesh points added

my $cntorig = 0;
my $cntfinal = 0;
my @history;
my $output = '';
my $diagnostics = '';

sub finite_intermediate {
    my ($value, $where, $description) = @_;
    isfinite($value) or die "$where: nonfinite $description\n";
    return $value;
}

for my $record (@$records) {
    if ($record->{type} ne 'data') {
        $output .= $record->{raw};
        next;
    }

    $cntorig++;
    my ($x, $y) = @{$record->{values}};
    my $where = "$record->{path}:$record->{line}";
    if (@history) {
        my $previous = $history[-1];
        $x != $previous->{values}[0] or die
            "$where: duplicate adjacent x '$record->{tokens}[0]' "
            . "(previous data row at line $previous->{line})\n";
    }

    if (@history >= 2) {
        my ($pp, $p) = @history[-2, -1];
        my ($x1, $y1) = @{$pp->{values}};
        my ($x2, $y2) = @{$p->{values}};
        my $previous_dx = finite_intermediate($x2 - $x1, $where, 'previous x spacing');
        my $previous_dy = finite_intermediate($y2 - $y1, $where, 'previous y difference');
        my $slope = finite_intermediate($previous_dy / $previous_dx, $where,
                                        'extrapolation slope');
        my $dx = finite_intermediate($x - $x2, $where, 'current x spacing');
        my $step = finite_intermediate($slope * $dx, $where, 'extrapolation step');
        my $yest = finite_intermediate($y2 + $step, $where, 'predicted value');
        my $scale = abs($y) > abs($yest) ? abs($y) : abs($yest);
        my ($error, $rel) = (0, 0);
        if ($scale != 0) {
            my $scaled_error = abs($y / $scale - $yest / $scale);
            my $scaled_sum = abs($y / $scale) + abs($yest / $scale);
            $rel = finite_intermediate(2 * $scaled_error / $scaled_sum, $where,
                                       'relative error');
            $error = $scale * $scaled_error;
            $error = 'overflow' unless isfinite($error);
        }
        $maxrel = $rel if $rel > $maxrel;

        if ($rel > $delta && abs($dx) > $dxmin) {
            my $activity = abs($y) / 2 + abs($y2) / 2;
            if ($activity > $miny) {
                my $x0 = finite_intermediate($x2 + $dx / 2, $where, 'midpoint x');
                if (!($reject_zero && abs($x0) < $smalleps)) {
                    my $dy = finite_intermediate($y - $y2, $where, 'current y difference');
                    my $slope2 = finite_intermediate($dy / $dx, $where,
                                                     'midpoint slope');
                    my $midpoint_step = finite_intermediate($slope2 * $dx, $where,
                                                            'midpoint step');
                    my $y0 = finite_intermediate($y2 + $midpoint_step / 2, $where,
                                                 'midpoint y');
                    $diagnostics .= "$x0 $y0 ADDED error=$error rel=$rel\n" if $debug;
                    $output .= "$x0 $y0\n";
                    $cntfinal++;
                    $nradd++;
                } elsif ($debug) {
                    $diagnostics .= "Not adding point at 0: $x0\n";
                }
            }
        }
    }

    $output .= $record->{raw};
    $cntfinal++;
    push @history, $record;
}

if ($verbose) {
    print STDERR "optimize_mesh: filename=$filename delta=$delta_text "
        . "dxmin=$dxmin_text miny=$miny_text\n";
}
print STDERR $diagnostics if length($diagnostics);
print STDOUT $output or die "Can't write standard output: $!\n";
if ($verbose) {
    print STDERR "optimize_mesh: max_relative_error=$maxrel added=$nradd "
        . "--- before=$cntorig after=$cntfinal\n";
}
