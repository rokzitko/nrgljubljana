#!/usr/bin/env perl
# Split a numeric table into one file per selected value column.

use strict;
use warnings;
use Cwd qw(abs_path getcwd);
use File::Basename qw(basename dirname);
use File::Spec;
use FindBin qw($Bin);
use lib $Bin;
use TableIO qw(atomic_write_many read_records);

our $REPORT_COORDINATES;
my $coordinates = $REPORT_COORDINATES // 1;
my $input = shift // 'custom.dat';
my $prefix = shift;
my @requested = @ARGV;

my $records = read_records($input);
my ($header_record, $seen_data);
my @rows;
for my $record (@$records) {
    if ($record->{type} eq 'data') {
        $seen_data = 1;
        push @rows, $record;
    } elsif ($record->{type} eq 'comment' && !$seen_data) {
        $header_record = $record;
    }
}
@rows or die "$input: no data rows\n";
defined($header_record) or die "$input: no leading column header\n";
(my $header_line = $header_record->{raw}) =~ s/[\r\n]+\z//;
$header_line =~ s/\A\s*#\s*//;
my @headers = split ' ', $header_line;
@headers > $coordinates or die "$input: header has no value columns\n";
for my $row (@rows) {
    my $width = @{$row->{tokens}};
    $width == @headers
        or die "$row->{path}:$row->{line}: expected " . scalar(@headers)
             . " columns, found $width\n";
}

my %positions;
push @{$positions{$headers[$_]}}, $_ for 0 .. $#headers;
my %wanted;
for my $name (@requested) {
    exists($positions{$name}) or die "$input: unknown column '$name'\n";
    if (grep { $_ < $coordinates } @{$positions{$name}}) {
        die "$input: coordinate column '$name' cannot be selected\n";
    }
    $wanted{$name} = 1;
}
my @selected = grep { $_ >= $coordinates && (!@requested || $wanted{$headers[$_]}) }
               0 .. $#headers;
@selected or die "$input: no value columns selected\n";
$prefix //= basename(getcwd());

sub path_identity {
    my ($path) = @_;
    my $resolved = abs_path($path);
    return $resolved if defined $resolved;
    my $parent = abs_path(dirname($path));
    return File::Spec->catfile($parent, basename($path)) if defined $parent;
    return File::Spec->canonpath(File::Spec->rel2abs($path));
}

my $input_identity = $input eq '-' ? undef : path_identity($input);
my @input_stat = $input eq '-' ? () : stat($input);
my (%outputs, %path_owner, %inode_owner);
my @diagnostics;
for my $index (@selected) {
    (my $safe = $headers[$index]) =~ s/[^A-Za-z0-9_.-]//g;
    length($safe) or die "$input: column '$headers[$index]' has an empty output basename\n";
    my $path = "$prefix-$safe.dat";
    length($path) or die "$input: empty output destination\n";
    -d $path and die "$path: destination is a directory\n";
    my $identity = path_identity($path);
    exists($path_owner{$identity})
        and die "$path: destination collides with $path_owner{$identity}\n";
    defined($input_identity) && $identity eq $input_identity
        and die "$path: destination aliases input $input\n";

    my @destination_stat = stat($path);
    if (@destination_stat) {
        my $inode = "$destination_stat[0]:$destination_stat[1]";
        exists($inode_owner{$inode})
            and die "$path: destination collides with $inode_owner{$inode}\n";
        @input_stat && $destination_stat[0] == $input_stat[0]
                    && $destination_stat[1] == $input_stat[1]
            and die "$path: destination aliases input $input\n";
        $inode_owner{$inode} = $path;
    }
    $path_owner{$identity} = $path;

    my @output_headers = (@headers[0 .. $coordinates - 1], $headers[$index]);
    my $content = '# ' . join(' ', @output_headers) . "\n";
    for my $row (@rows) {
        my @values = (@{$row->{tokens}}[0 .. $coordinates - 1],
                      $row->{tokens}[$index]);
        $content .= join(' ', @values) . "\n";
    }
    $outputs{$path} = $content;
    push @diagnostics, "$headers[$index] -> $path\n";
}

atomic_write_many(\%outputs);
print @diagnostics;
1;
