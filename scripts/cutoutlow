#!/usr/bin/perl
# Dump file, skipping those lines where the first column has a value 
# smaller (in absolute value) than some given cut-off value.
# Rok Zitko, rok.zitko@ijs.si, Oct 2010

use warnings;
use strict;
use FindBin qw($Bin);
use lib $Bin;
use TableIO qw(join_outputs parse_number read_records);

@ARGV >= 1 or die "Usage: cutoutlow <cutoff> [filename ...]\n";
my $cutoff = parse_number(shift @ARGV, 'cutoutlow: cutoff');
$cutoff >= 0 or die "cutoutlow: cutoff must be nonnegative\n";
my @paths = @ARGV ? @ARGV : ('-');
my $stdin_count = grep { $_ eq '-' } @paths;
$stdin_count <= 1 or die "cutoutlow: standard input may be specified at most once\n";

my @sources = map {
    read_records($_, minimum_columns => 1, fixed_columns => 1, numeric_columns => 1)
} @paths;
my @parts;
for my $records (@sources) {
    my $part = '';
    for my $record (@$records) {
        if ($record->{type} ne 'data') {
            $part .= $record->{raw};
        } elsif (abs($record->{values}[0]) >= $cutoff) {
            $part .= join(' ', @{$record->{tokens}}) . "\n";
        }
    }
    push @parts, $part;
}
print STDOUT join_outputs(@parts) or die "Can't write cutoutlow output: $!\n";
close(STDOUT) or die "Can't finish cutoutlow output: $!\n";
