#!/bin/bash
# Start Mathematica in batch mode and run the "NRG Ljubljana"
# initialisation script
# Rok Zitko, rok.zitko@ijs.si, 2009-2018

if [ "$1" = "-h" ]
then
  echo Usage: nrginit
  exit 0
fi

NRGDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
NRG_INITSCRIPT=${NRGDIR}/nrginit.m
# Kernel: argument, else `math` on PATH, else a standard macOS application bundle.
MATH="${1:-}"
if [ -z "$MATH" ]; then
  MATH=math
  if ! command -v math >/dev/null 2>&1; then
    for k in /Applications/Wolfram.app/Contents/MacOS/wolfram /Applications/Mathematica.app/Contents/MacOS/wolfram \
             /Applications/Wolfram.app/Contents/MacOS/WolframKernel /Applications/Mathematica.app/Contents/MacOS/WolframKernel; do
      if [ -x "$k" ]; then MATH="$k"; break; fi
    done
  fi
fi
$MATH -batchinput -batchoutput <<EOF
NRGDIR="${NRGDIR}";
Get["${NRG_INITSCRIPT}"];
EOF
